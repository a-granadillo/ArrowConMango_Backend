# Database driver: 'sqlite' (dev, no setup) | 'postgres' (prod)
DB_DRIVER=sqlite
DB_PATH=./arrow.sqlite

# PostgreSQL — only needed when DB_DRIVER=postgres.
# DATABASE_URL (the format Neon/Render hand out) takes priority over the
# discrete DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME vars below when set.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=arrow_con_mango
# Auto-create/alter the Postgres schema from entities (no migrations exist yet).
DB_SYNCHRONIZE=true
# Neon/Render require SSL; a local/docker-compose Postgres doesn't support it
# and will hang retrying forever if this is left on. true for hosted Postgres,
# false for docker-compose.yml's local Postgres (already set there).
DB_SSL=true

# Auth
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed CORS origins, e.g. https://your-app.github.io.
# Leave unset in local dev to allow any origin.
CORS_ORIGINS=

# Comma-separated user ids allowed to overwrite level-*/hex-* (PUT /levels/:id).
# Leave empty until you know your own registered user id.
ADMIN_USER_IDS=

# Server
PORT=3000
NODE_ENV=development

# Seed the campaign + hexagonal catalogues on every boot (idempotent — safe
# to leave on, but usually only needed for the first deploy).
SEED_ON_BOOT=false
